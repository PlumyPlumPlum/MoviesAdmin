@model IEnumerable<MoviesAdmin.Models.AudienceRating>

@{
    ViewData["Title"] = "Content Ratings";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Content Ratings</h1>
        <p class="text-muted mb-0">
            Manage the content classifications in your movie catalogue.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add Content Rating
    </a>
</div>

<div class="table-responsive movie-table-container">
    <table class="table align-middle"
        <thead class="table-light">
            <tr>
                <th scope="col"
                    class="text-uppercase text-secondary small">
                    Content Rating
                </th>
                <th scope="col"
                    class="text-uppercase text-secondary small text-end">
                    Actions
                </th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="2" class="text-center text-muted py-4">
                        No content ratings have been added yet.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary">
                                @item.Title
                            </span>
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                View
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
