@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Delete Draft";
}

<div class="fb-details">

    <header class="mb-4">
        <p class="fb-details-eyebrow">
            CRITIC WORKSPACE
        </p>

        <h1>Delete Draft Review</h1>

        <p class="text-muted">
            Reviewing: <strong>@Model.Movie.Title</strong>
        </p>
    </header>

    <section class="fb-details-panel">

        <div class="alert alert-warning mb-4">
            <strong>Are you sure?</strong>

            <p class="mb-0 mt-2">
                Deleting this draft will permanently remove
                your review and its rating.
                This action cannot be undone.
            </p>
        </div>

        <h2 class="mb-3">Review to be deleted</h2>

        <div class="mb-4">
            <span class="badge bg-secondary mb-3">
                Draft
            </span>

            <p class="fw-semibold">
                Rating: @Model.Rating / 5
            </p>

            <p class="fb-review-description">@Model.Description.Trim()</p>
        </div>

        <form asp-controller="CriticReviews"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              asp-antiforgery="true"
              method="post">

            <div class="d-flex flex-wrap gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Draft
                </button>

                <a asp-controller="Movies"
                   asp-action="Details"
                   asp-route-id="@Model.MovieId"
                   class="btn btn-outline-secondary">
                    Keep Draft
                </a>

            </div>

        </form>

    </section>
</div>
