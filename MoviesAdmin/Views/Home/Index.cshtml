@{
    ViewData["Title"] = "Welcome";
}

<section class="fb-welcome">

    <div class="fb-welcome-content">

        <p class="fb-welcome-label">
            FOULBANANAS · MOVIE MANAGEMENT
        </p>

        <h1>
            Where movies meet their critics.
        </h1>

        <p class="fb-welcome-description">
            Your home for managing movie information,
            writing critic reviews, and publishing
            your ratings.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Movies"
               asp-action="Index"
               class="btn fb-welcome-button">
                Open Movie Library
            </a>

            // Verify the authenticated user's role
            <div class="mt-3">
                @if (User.IsInRole("administrator"))
                {
                    <span class="badge bg-success">
                        Administrator Verified
                    </span>
                }
                else if (User.IsInRole("critic"))
                {
                    <span class="badge bg-info text-dark">
                        Critic Verified
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        No Role Assigned
                    </span>
                }
            </div>
        }
        else
        {
            <a asp-controller="Account"
               asp-action="Login"
               asp-route-returnUrl="/Movies"
               class="btn fb-welcome-button">
                Sign In
            </a>
        }

        <p class="fb-welcome-footer">
            Secure access for administrators and critics.
        </p>

    </div>

    <div class="fb-welcome-artwork">

        <img src="~/images/foulbananas-logo.png"
             asp-append-version="true"
             alt="FoulBananas movie review mascot and logo"
             class="fb-welcome-logo"
             width="700"
             height="700" />

    </div>
</section>
